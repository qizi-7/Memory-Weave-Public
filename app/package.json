{
  "name": "memory-weave-next",
  "version": "0.3.9",
  "private": true,
  "description": "Local personal WeChat archive workspace",
  "author": "Personal",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-info.cjs",
    "start": "electron .",
    "build:native": "node scripts/build-native.cjs",
    "pretest": "node scripts/build-native.cjs --test",
    "test": "node --test tests/*.test.cjs",
    "pack": "npm run build:native && npm run build && electron-builder --mac dir dmg --arm64"
  },
  "build": {
    "appId": "local.personal.memoryweave.next",
    "productName": "Memory Weave Next",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null
    },
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "native/**",
          "licenses/SQLCipher.txt",
          "licenses/wechat-emoji-vocabulary.txt"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/silk-wasm/lib/silk.wasm"
    ]
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sax": "1.6.1",
    "silk-wasm": "3.7.1"
  },
  "license": "MIT"
}
